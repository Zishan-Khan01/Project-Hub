// use prisma-8

enum UserRole {
  ADMIN
  PROJECT_MANAGER
  DEVELOPER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Organization {
  id        Uuid     @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  users    User[]
  teams    Team[]
  projects Project[]
  auditLogs AuditLog[]
}

model User {
  id           Uuid     @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(DEVELOPER)

  organizationId Uuid

  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  organization Organization @relation(
    fields: [organizationId],
    references: [id],
    onDelete: Cascade
  )

  teamMemberships    TeamMember[]
  projectMemberships ProjectMember[]

  createdProjects Project[] @relation("ProjectCreator")

  assignedTasks Task[] @relation("TaskAssignee")
  createdTasks  Task[] @relation("TaskCreator")

  comments Comment[]
  auditLogs AuditLog[]
  @@index([organizationId])
}

model Team {
  id             Uuid   @id @default(uuid())
  name           String
  organizationId Uuid

  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  organization Organization @relation(
    fields: [organizationId],
    references: [id],
    onDelete: Cascade
  )

  members  TeamMember[]
  projects Project[]

  @@index([organizationId])
}

model TeamMember {
  id     Uuid @id @default(uuid())
  teamId Uuid
  userId Uuid

  joinedAt DateTime @default(now())

  team Team @relation(
    fields: [teamId],
    references: [id],
    onDelete: Cascade
  )

  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  @@unique([teamId, userId])
  @@index([userId])
}

model Project {
  id          Uuid   @id @default(uuid())
  name        String
  description String?

  organizationId Uuid
  teamId         Uuid?
  createdById    Uuid

  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  organization Organization @relation(
    fields: [organizationId],
    references: [id],
    onDelete: Cascade
  )

  team Team? @relation(
    fields: [teamId],
    references: [id],
    onDelete: SetNull
  )

  createdBy User @relation(
    "ProjectCreator",
    fields: [createdById],
    references: [id],
    onDelete: Restrict
  )

  members ProjectMember[]
  tasks   Task[]

  @@index([organizationId])
  @@index([teamId])
  @@index([createdById])
}

model ProjectMember {
  id        Uuid @id @default(uuid())
  projectId Uuid
  userId    Uuid

  joinedAt DateTime @default(now())

  project Project @relation(
    fields: [projectId],
    references: [id],
    onDelete: Cascade
  )

  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  @@unique([projectId, userId])
  @@index([userId])
}

model Task {
  id          Uuid   @id @default(uuid())
  title       String
  description String?

  status   TaskStatus   @default(TODO)
  priority TaskPriority @default(MEDIUM)

  dueDate DateTime?

  projectId Uuid
  assigneeId Uuid?
  createdById Uuid

  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  project Project @relation(
    fields: [projectId],
    references: [id],
    onDelete: Cascade
  )

  assignee User? @relation(
    "TaskAssignee",
    fields: [assigneeId],
    references: [id],
    onDelete: SetNull
  )

  createdBy User @relation(
    "TaskCreator",
    fields: [createdById],
    references: [id],
    onDelete: Restrict
  )

  comments Comment[]

  @@index([projectId])
  @@index([assigneeId])
  @@index([createdById])
  @@index([status])
}

model Comment {
  id      Uuid   @id @default(uuid())
  content String

  taskId Uuid
  userId Uuid

  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  task Task @relation(
    fields: [taskId],
    references: [id],
    onDelete: Cascade
  )

  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  @@index([taskId])
  @@index([userId])
}

model AuditLog {
  id             Uuid     @id @default(uuid())
  organizationId Uuid
  userId         Uuid?
  action         String
  resource       String
  resourceId     Uuid?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(
    fields: [organizationId],
    references: [id],
    onDelete: Cascade
  )

  user User? @relation(
    fields: [userId],
    references: [id],
    onDelete: SetNull
  )

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@index([resource, resourceId])
}